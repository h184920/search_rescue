#!/usr/bin/python3
# EASY-INSTALL-ENTRY-SCRIPT: 'search-rescue','console_scripts','search_rescue'
__requires__ = 'search-rescue'
import re
import sys
from pkg_resources import load_entry_point

if __name__ == '__main__':
    sys.argv[0] = re.sub(r'(-script\.pyw?|\.exe)?$', '', sys.argv[0])
    sys.exit(
        load_entry_point('search-rescue', 'console_scripts', 'search_rescue')()
    )
